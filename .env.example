# Copy to .env on each machine. Never commit .env.
# Single-Mac development defaults. On Computer 2, override with Computer 1's
# reachable LAN hostname/IP; never use localhost on Computer 2.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=hostel-electricity-client
MQTT_KEEPALIVE_SECONDS=60

# Local ECO historical replay publisher (Computer 1/Mac)
ECO_DATASET_PATH=./data/processed/eco_household_1_15min.parquet
ECO_MQTT_HOST=127.0.0.1
ECO_MQTT_PORT=1883
ECO_SITE_ID=hostel-a
ECO_METER_ID=eco-household-01
ECO_REPLAY_INTERVAL_SECONDS=0.25
ECO_MAX_RECORDS=
ECO_MQTT_CLIENT_ID=eco-replay-publisher

# ML inference service (override ML_MQTT_HOST on Computer 2)
ML_MODEL_PATH=./models/eco_household_1_iforest.joblib
ML_MQTT_HOST=127.0.0.1
ML_MQTT_PORT=1883
ML_READINGS_TOPIC=hostel/v1/readings/+/+
ML_MQTT_CLIENT_ID=hostel-ml-inference

# Local Node-RED dashboard endpoint used by the read-only readiness check.
NODE_RED_DASHBOARD_URL=http://127.0.0.1:1880/dashboard/hostel-electricity

# Computer 1 MQTT-to-SQLite receiver (local broker only in Phase 4E)
DATABASE_PATH=database/hostel_electricity.sqlite3
STORAGE_MQTT_HOST=127.0.0.1
STORAGE_MQTT_PORT=1883
STORAGE_MQTT_CLIENT_ID=hostel-storage-service

LOG_LEVEL=INFO
