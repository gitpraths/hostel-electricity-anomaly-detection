# Copy to .env on each machine. Never commit .env.
# Computer 1's reachable LAN hostname or IP; do not use localhost on Computer 2.
MQTT_HOST=computer-1-hostname-or-lan-ip
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=hostel-electricity-client
MQTT_KEEPALIVE_SECONDS=60

# Local ECO historical replay publisher (Computer 1/Mac)
ECO_DATASET_PATH=./data/processed/eco_household_1_15min.parquet
ECO_MQTT_HOST=127.0.0.1
ECO_MQTT_PORT=1883
ECO_SITE_ID=hostel-a
ECO_METER_ID=eco-household-01
ECO_REPLAY_INTERVAL_SECONDS=0.25
ECO_MAX_RECORDS=
ECO_MQTT_CLIENT_ID=eco-replay-publisher

# ML MQTT inference service (use Computer 1's LAN host on Computer 2)
ML_MODEL_PATH=./models/eco_household_1_iforest.joblib
ML_MQTT_HOST=127.0.0.1
ML_MQTT_PORT=1883
ML_READINGS_TOPIC=hostel/v1/readings/+/+
ML_MQTT_CLIENT_ID=hostel-ml-inference

# ML MQTT inference service (use Computer 1's LAN host on Computer 2)
ML_MODEL_PATH=./models/eco_household_1_iforest.joblib
ML_MQTT_HOST=127.0.0.1
ML_MQTT_PORT=1883
ML_READINGS_TOPIC=hostel/v1/readings/+/+
ML_MQTT_CLIENT_ID=hostel-ml-inference

DATA_DIR=./data
DATABASE_URL=sqlite:///./data/hostel_electricity.sqlite3
ECO_DATA_DIR=./data/raw/eco
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
